{
  "schemaVersion": 1,
  "meta": {
    "id": "demo.mock",
    "type": "comic",
    "name": "示例规则（本地 Mock）",
    "baseUrl": "https://example.invalid",
    "version": "0.2.0",
    "author": "acgn_index",
    "lang": "zh",
    "description": "仅用于本地开发与测试，不指向任何真实站点。",
    "notice": "示例规则，不含任何真实站点地址。"
  },
  "request": {
    "headers": {
      "User-Agent": "ACGNIndex/0.2"
    },
    "timeoutMs": 15000,
    "encoding": "utf-8",
    "retry": 0
  },
  "capabilities": {
    "search": {
      "mode": "query",
      "url": "/search?q={{key}}&page={{page}}",
      "method": "GET",
      "pageSize": 20,
      "list": {
        "selector": ".result .item"
      },
      "fields": {
        "id": {
          "selector": "a",
          "attr": "href",
          "regex": "/(\\d+)$",
          "group": 1
        },
        "title": {
          "selector": ".title"
        },
        "cover": {
          "selector": "img",
          "attr": "src",
          "absolute": true
        }
      },
      "pagination": {
        "pageSize": 20
      }
    },
    "detail": {
      "url": "/work/{{id}}",
      "fields": {
        "title": {
          "selector": "h1"
        },
        "cover": {
          "selector": ".cover img",
          "attr": "src",
          "absolute": true
        },
        "intro": {
          "selector": ".intro",
          "html": true
        },
        "volumes": {
          "items": {
            "selector": ".volumes li"
          },
          "fields": {
            "id": {
              "selector": "a",
              "attr": "data-id"
            },
            "title": {
              "selector": "a"
            }
          }
        }
      }
    },
    "toc": {
      "url": "/work/{{id}}/chapters",
      "list": {
        "selector": ".chapters li"
      },
      "fields": {
        "id": {
          "selector": "a",
          "attr": "data-chapter-id"
        },
        "title": {
          "selector": "a"
        },
        "url": {
          "selector": "a",
          "attr": "href",
          "absolute": true
        }
      }
    },
    "content": {
      "mode": "images",
      "url": "{{chapter.url}}",
      "fields": {
        "images": {
          "selector": ".reader img",
          "attr": "src",
          "multiple": true,
          "absolute": true
        },
        "referer": {
          "const": "{{baseUrl}}"
        }
      }
    }
  }
}
