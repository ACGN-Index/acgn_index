{
  "schemaVersion": 1,
  "meta": {
    "id": "builtin.kazumi.mxdm",
    "type": "anime",
    "name": "MX动漫（视频）",
    "baseUrl": "https://www.dcc3.com",
    "version": "1.0.0",
    "author": "acgn_index（改写自 KazumiRules）",
    "lang": "zh",
    "description": "改写自 Kazumi 开源规则：关键词搜索、剧集表，并从播放页取出 HLS 直链。",
    "notice": "规则改写自 Predidit/KazumiRules（MIT）。视频由第三方站点提供，本应用不托管、不分发任何内容；仅供个人学习交流，默认关闭。"
  },
  "request": {
    "headers": {
      "Referer": "https://www.dcc3.com/"
    },
    "timeoutMs": 20000,
    "encoding": "utf-8",
    "retry": 1
  },
  "capabilities": {
    "search": {
      "mode": "query",
      "url": "https://www.dcc3.com/search/?wd={{key}}",
      "list": {
        "selector": "div.search ul li"
      },
      "fields": {
        "id": {
          "selector": "h3 a",
          "attr": "href",
          "regex": "/(\\d+)/?$",
          "group": 1
        },
        "title": {
          "selector": "h3 a"
        },
        "cover": {
          "selector": "img",
          "attr": "data-original",
          "absolute": true,
          "fallback": {
            "selector": "img",
            "attr": "src",
            "absolute": true
          }
        },
        "url": {
          "selector": "h3 a",
          "attr": "href",
          "absolute": true
        }
      }
    },
    "detail": {
      "url": "{{url}}",
      "fields": {
        "title": {
          "selector": "div.detail h2"
        },
        "cover": {
          "selector": "div.detail div.cover img",
          "attr": "data-original",
          "absolute": true,
          "fallback": {
            "selector": "div.detail div.cover img",
            "attr": "src",
            "absolute": true
          }
        },
        "intro": {
          "selector": "div.detail li.blurb",
          "regex": "简介[:：]\\s*([\\s\\S]*)",
          "group": 1
        },
        "status": {
          "selector": "div.detail li em"
        },
        "year": {
          "selector": "div.detail li",
          "regex": "年份[:：]\\s*(\\d{4})",
          "group": 1
        },
        "tags": {
          "selector": "div.detail li",
          "regex": "类型[:：]\\s*([\\s\\S]*)$",
          "group": 1
        }
      }
    },
    "toc": {
      "url": "{{url}}",
      "list": {
        "selector": "div.playlist div.row[style*=\"display: block\"] ul li"
      },
      "fields": {
        "title": {
          "selector": "a"
        },
        "url": {
          "selector": "a",
          "attr": "href",
          "absolute": true
        }
      }
    },
    "content": {
      "mode": "video",
      "url": "{{chapter.url}}",
      "fields": {
        "url": {
          "selector": "script",
          "js": "function (value) { var text = String(value || ''); var match = /url:\\s*'([^']+\\.m3u8[^']*)'/.exec(text); if (!match) { match = /url:\\s*\"([^\"]+\\.m3u8[^\"]*)\"/.exec(text); } return match ? match[1] : null; }"
        },
        "type": {
          "const": "hls"
        },
        "referer": {
          "const": "https://www.dcc3.com/"
        }
      }
    }
  }
}
